# Property Contact Finder — example environment variables
# Copy this file to .env and fill in real values. .env is gitignored.

# --- OpenRouter (AI) ---
OPENROUTER_API_KEY=

# --- MBIE APIs ---
MBIE_COMPANIES_REGISTER_API_KEY=
MBIE_ENTITY_ROLE_SEARCH_API_KEY=

# --- Google Places Autocomplete ---
GOOGLE_PLACES_API_KEY=

# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/property_contact_finder

# --- App ---
PORT=3001
NODE_ENV=development
